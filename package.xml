<?xml version="1.0"?>
<package format="2">
  <name>bobac3_auto_charge</name>
  <version>1.0.0</version>
  <description>
    基于 AR 码视觉引导的服务机器人自主回充节点。
    三阶段状态机：双参数收敛对准 -> 分段倒退至固定点 -> 盲倒对接。
  </description>

  <maintainer email="542111348@qq.com">李东阳</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>ar_track_alvar_msgs</build_depend>
  <build_depend>relative_move</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>ar_track_alvar_msgs</exec_depend>
  <exec_depend>relative_move</exec_depend>

  <export />
</package>